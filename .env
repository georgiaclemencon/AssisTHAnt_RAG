# ============================================================
# LLM / embeddings backend — pick ONE option, comment out the other.
# ============================================================

# ---- Option 1: Ollama in a Docker container (port 11435) [default] ----
# "ollama" = the Docker service name, resolved automatically on the
# compose network. Do not replace with localhost/127.0.0.1.
LLM_BINDING=ollama
LLM_MODEL=phi4-mini:3.8b-q4_K_M
LLM_BINDING_HOST=http://ollama:11435
LLM_BINDING_API_KEY=not-needed

EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://ollama:11435

# ---- Option 2: LM Studio running natively on Windows (OpenAI-compatible API) ----
# Breaks 100%-Docker portability: requires LM Studio installed and
# started manually on the host ("Developer" tab > "Start Server",
# default port 1234). Local dev only.
#
# LLM_BINDING=openai
# LLM_MODEL=qwen2.5-3b-instruct
# LLM_BINDING_HOST=http://host.docker.internal:1234/v1
# LLM_BINDING_API_KEY=lm-studio
#
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_DIM=768
# EMBEDDING_BINDING_HOST=http://host.docker.internal:1234/v1

# ============================================================
# Language used for entity/relationship summaries generated by the LLM.
# ============================================================
SUMMARY_LANGUAGE=English
