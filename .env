# ============================================================
# Backend LLM/embeddings — choisis UNE option, commente l'autre.
# ============================================================

# ---- Option 1 : Ollama en conteneur Docker (port 11435) [par défaut] ----
# "ollama" = nom du service Docker, résolu automatiquement sur le
# réseau interne du compose. Ne pas remplacer par localhost/127.0.0.1.
LLM_BINDING=ollama
LLM_MODEL=phi4-mini:3.8b-q4_K_M
LLM_BINDING_HOST=http://ollama:11435
LLM_BINDING_API_KEY=not-needed

EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://ollama:11435

# ---- Option 2 : LM Studio natif Windows (API OpenAI-compatible) ----
# Casse la portabilité 100%-Docker : nécessite LM Studio installé et
# lancé à la main sur le PC hôte (onglet "Developer" > "Start Server",
# port par défaut 1234). A réserver au dev local.
#
# LLM_BINDING=openai
# LLM_MODEL=qwen2.5-3b-instruct
# LLM_BINDING_HOST=http://host.docker.internal:1234/v1
# LLM_BINDING_API_KEY=lm-studio
#
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_DIM=768
# EMBEDDING_BINDING_HOST=http://host.docker.internal:1234/v1
